# VIGIL environment — copy to .env and fill in. NEVER commit .env.
# Decision layer
# VIGIL_LLM=qwen
# VIGIL_QWEN_API_KEY=
# VIGIL_QWEN_BASE=https://hackathon.bitgetops.com/v1
# VIGIL_QWEN_MODEL=qwen3.8-max

# Execution: paper (default) | bitget (demo venue, requires the three creds below)
# VIGIL_EXEC=bitget
# VIGIL_BITGET_API_KEY=
# VIGIL_BITGET_SECRET=
# VIGIL_BITGET_PASSPHRASE=
# VIGIL_BITGET_BASE=https://api.bitget.com   # PAPTRADING:1 is applied automatically (demo)

# Ledger / tuning
# VIGIL_DB_PATH=./vigil.sqlite
# VIGIL_SEED_USD=10000
# VIGIL_MAX_DD=0.10
# VIGIL_SCAN_MS=300000
# PORT=8080